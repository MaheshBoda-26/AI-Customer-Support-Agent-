# NVIDIA NIM API (required)
# Get from: https://build.nvidia.com/
# Use base URL: https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super
NVIDIA_NIM_FAST_MODEL=nvidia/nemotron-3-super

# Qdrant Vector Database (required)
# Option 1: Qdrant Cloud (https://cloud.qdrant.io/) - use your cluster URL and API key
# Option 2: Local Docker - QDRANT_URL=http://localhost:6333 (no API key needed)
QDRANT_URL=
QDRANT_API_KEY=

# Supabase (required)
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Embeddings (required)
# voyage-3 (recommended, 1024 dims) - get key from https://www.voyageai.com/
# OR use OpenAI: text-embedding-3-small (1536 dims) - requires OPENAI_API_KEY
EMBEDDING_MODEL=voyage-3
VOYAGE_API_KEY=
# OPENAI_API_KEY=

# Optional: Slack webhook for handoff notifications
SLACK_WEBHOOK_URL=

# App Settings
LOG_LEVEL=INFO
ENVIRONMENT=development